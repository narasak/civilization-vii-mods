<?xml version="1.0" encoding="utf-8"?>
<Mod id="lth-thai-language" version="11" xmlns="ModInfo">
	<Properties>
		<!-- ASCII ONLY. Thai here is drawn on the Add-Ons screen, where our font is not loaded, so it
		     shows as empty boxes. (It was first blamed for a crash on quit; a control run with NO third-party mods (2026-11-06 08:28) crashed identically, so the crash is not ours.)
		     tools/check.py enforces this. -->
		<Name>Thai Language Pack</Name>
		<Description>Thai translation of the whole game: menus, tooltips, Civilopedia, narrative events and leader dialog, for the base game, all three Ages and all DLC. Bundles Thai fonts (Sarabun, Kanit). Keep the game language set to English. Source: github.com/narasak/civilization-vii-mods</Description>
		<Authors>narasak</Authors>
		<Package>Mod</Package>
		<AffectsSavedGames>0</AffectsSavedGames>
		<EnabledByDefault>1</EnabledByDefault>
	</Properties>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<!-- LTH:CRITERIA BEGIN -->
		<Criteria id="lth-cond-01">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-02">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-03">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-04">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<Criteria id="lth-cond-05" any="true">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-06" any="true">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-07" any="true">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="lth-cond-08">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<!-- LTH:CRITERIA END -->
	</ActionCriteria>
	<ActionGroups>
		<!-- Front end (main menu, options, game setup). -->
		<ActionGroup id="lth-shell" scope="shell" criteria="always">
			<Properties>
				<!-- After every base/DLC text group, so our en_US <Replace> rows win. -->
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UIScripts>
					<Item>ui/lth-thai-fonts.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>fonts/lth-Sarabun-Regular.ttf</Item>
					<Item>fonts/lth-Sarabun-SemiBold.ttf</Item>
					<Item>fonts/lth-Kanit-Medium.ttf</Item>
					<Item>fonts/lth-Kanit-SemiBold.ttf</Item>
					<Item>core/ui/themes/default/panel-animations.css</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<!-- In game. Same text + font loader; no diagnostics panel. -->
		<ActionGroup id="lth-game" scope="game" criteria="always">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UIScripts>
					<Item>ui/lth-thai-fonts.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>fonts/lth-Sarabun-Regular.ttf</Item>
					<Item>fonts/lth-Sarabun-SemiBold.ttf</Item>
					<Item>fonts/lth-Kanit-Medium.ttf</Item>
					<Item>fonts/lth-Kanit-SemiBold.ttf</Item>
					<Item>core/ui/themes/default/panel-animations.css</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<!-- Text groups, one per load condition of the English rows they replace.
		     GENERATED by tools/build_text.py — do not edit between the markers. -->
		<!-- LTH:GENERATED BEGIN -->
		<ActionGroup id="lth-text-01" scope="game" criteria="lth-cond-01">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/01-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-02" scope="game" criteria="lth-cond-02">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/02-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-03" scope="game" criteria="lth-cond-03">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/03-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-04" scope="game" criteria="lth-cond-04">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/04-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-05" scope="game" criteria="lth-cond-05">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/05-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-06" scope="game" criteria="lth-cond-06">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/06-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-07" scope="game" criteria="lth-cond-07">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/07-game.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<ActionGroup id="lth-text-08" scope="shell" criteria="lth-cond-08">
			<Properties><LoadOrder>1000</LoadOrder></Properties>
			<Actions><UpdateText><Item>text/gen/08-shell.xml</Item></UpdateText></Actions>
		</ActionGroup>
		<!-- LTH:GENERATED END -->
	</ActionGroups>
</Mod>

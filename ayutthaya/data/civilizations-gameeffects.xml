<?xml version="1.0" encoding="utf-8"?>
<!-- Ability "Venice of the East". Each modifier copies an official one:
     reveal tree = MOD_REVEAL_CIV_CULTURE_TREE_MAJAPAHIT; plot yield on a terrain = MOD_PARTHENON_ROUGH_DIPLOMACY;
     building yield per city = ATTACH_CS_CULTURAL_CULTURE_ON_SAW_PIT; city on terrain = MOD_QHAPAQ_NAN_AUTO_TREASURE_FLEET. -->
<GameEffects xmlns="GameEffects">
	<Modifier id="MOD_REVEAL_CIV_CULTURE_TREE_LTH_AYUTTHAYA" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_REVEAL_CULTURE_TREE">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT">
				<Argument name="TraitType">TRAIT_LTH_AYUTTHAYA</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ProgressionTreeType">TREE_CIVICS_EX_LTH_AYUTTHAYA</Argument>
	</Modifier>
	<!-- River prawns: +1 Food on every Navigable River tile you own. -->
	<Modifier id="MOD_LTH_AYU_RIVER_FOOD" collection="COLLECTION_PLAYER_PLOT_YIELDS" effect="EFFECT_PLOT_ADJUST_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLOT_TERRAIN_TYPE_MATCHES">
				<Argument name="TerrainType">TERRAIN_NAVIGABLE_RIVER</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="YieldType">YIELD_FOOD</Argument>
		<Argument name="Amount">1</Argument>
		<Argument name="Tooltip">LOC_TRAIT_LTH_AYUTTHAYA_ABILITY_NAME</Argument>
	</Modifier>
	<!-- Floating markets: Bazaars in settlements with a Navigable River tile +3 Gold. -->
	<Modifier id="MOD_LTH_AYU_BAZAAR_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_CONSTRUCTIBLE_YIELD">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_HAS_TERRAIN">
				<Argument name="TerrainType">TERRAIN_NAVIGABLE_RIVER</Argument>
				<Argument name="Amount">1</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ConstructibleType">BUILDING_BAZAAR</Argument>
		<Argument name="YieldType">YIELD_GOLD</Argument>
		<Argument name="Amount">3</Argument>
		<Argument name="Tooltip">LOC_TRAIT_LTH_AYUTTHAYA_ABILITY_NAME</Argument>
	</Modifier>
</GameEffects>
